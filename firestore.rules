rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isMentor() {
      return hasRole('mentor');
    }

    function isJudge() {
      return hasRole('judge');
    }

    function isFaculty() {
      return hasRole('faculty');
    }

    function isStudent() {
      return hasRole('student');
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Buses collection
    match /buses/{busId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Dynamic Rooms collection
    match /rooms/{roomId} {
      allow read: if true; // Publicly readable for dynamic forms
      allow write: if isAdmin();
    }

    // Room Submissions collection
    match /roomSubmissions/{submissionId} {
      allow create: if true; // Anyone with the room link can submit
      allow read: if isAdmin() || isMentor() || isFaculty();
      allow update, delete: if isAdmin();
    }

    // Attendance Records
    match /attendanceRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isMentor();
      allow delete: if isAdmin();
    }

    // Photos collection
    match /photos/{photoId} {
      allow read: if true; // Public verification allowed via QR
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uploadedBy.userId == request.auth.uid);
    }

    // Announcements & Notifications
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // System Activity Logs
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
  }
}
